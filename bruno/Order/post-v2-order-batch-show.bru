meta {
  name: List orders by ids
  type: http
  seq: 5
  tags: [
    Order
  ]
}

post {
  url: {{baseUrl}}/v2/order/batch-show
  body: json
  auth: inherit
}

body:json {
  {
    "order_ids": [
      {{orderId}}
    ]
  }
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  Up to 100 orders of the site in the order of `order_ids`, in the format of `order/show`: poll statuses, packages and tracking in one request instead of one request per order. Orders of other sites and unknown ids are left out.
}

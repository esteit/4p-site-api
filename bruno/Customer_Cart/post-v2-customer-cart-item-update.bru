meta {
  name: Update a cart item
  type: http
  seq: 3
  tags: [
    Customer_Cart
  ]
}

post {
  url: {{baseUrl}}/v2/customer-cart/item/update
  body: json
  auth: inherit
}

body:json {
  {
    "item_id": {{cartItemId}},
    "quantity": 1,
    "selected": true
  }
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  Quantity and selection for the checkout; omitted fields stay. A quantity above the stock gives 422 on `quantity` with the stock in `detail` (it is not cut silently). An item of another cart gives 404.
}

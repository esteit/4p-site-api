meta {
  name: Activate an article
  type: http
  seq: 8
  tags: [
    Content
  ]
}

post {
  url: {{baseUrl}}/v2/content/article/activate
  body: json
  auth: inherit
}

body:json {
  {
    "article_id": {{articleId}}
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  Shows the article in the lists and menus of the site again (`active: true`), in all variations. The response is the article in `site_variation`.
}

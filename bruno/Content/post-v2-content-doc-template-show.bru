meta {
  name: Show a template
  type: http
  seq: 12
  tags: [
    Content
  ]
}

post {
  url: {{baseUrl}}/v2/content/doc-template/show
  body: json
  auth: inherit
}

body:json {
  {
    "template_id": {{templateId}}
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  A template of the site or a shared one with HTML, styles, scripts and block settings. A template of another site gives 404.
}

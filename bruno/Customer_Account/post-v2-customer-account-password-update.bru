meta {
  name: Change the password
  type: http
  seq: 6
  tags: [
    Customer_Account
  ]
}

post {
  url: {{baseUrl}}/v2/customer-account/password/update
  body: json
  auth: inherit
}

body:json {
  {
    "old_password": "{{customerPassword}}",
    "new_password": "{{customerNewPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

script:post-response {
  if (res.getStatus() === 200 && res.body.data && res.body.data.token) {
    bru.setVar("customerToken", res.body.data.token);
    bru.setVar("customerRefreshToken", res.body.data.refresh_token);
  }
}

docs {
  Sets a new password when `old_password` is right. All customer tokens and refresh tokens of the customer stop working, this one too: the answer has new tokens. A wrong `old_password` gives 422; after 5 wrong ones within 15 minutes — 429 `sign-in-locked`.
}

meta {
  name: Show a site variation
  type: http
  seq: 3
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v2/settings/site-variation/show
  body: json
  auth: inherit
}

body:json {
  {
    "code": "default"
  }
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  A variation of the site by code; `default` — the variation without a code.
}

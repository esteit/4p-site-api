meta {
  name: Create a theme
  type: http
  seq: 12
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v2/settings/theme/create
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno theme",
    "vars": ":root{--accent:#e30613}",
    "styles": "body{color:var(--accent)}"
  }
}

assert {
  res.status: eq 201
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

script:post-response {
  if (res.getStatus() === 201 && res.body.data) {
    bru.setVar("themeId", res.body.data.id);
  }
}

docs {
  Creates a theme of the site. The slug is made from the name if omitted; a taken slug gives 422.
}

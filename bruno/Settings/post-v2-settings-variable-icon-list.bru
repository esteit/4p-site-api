meta {
  name: List icons of settings
  type: http
  seq: 5
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v2/settings/variable/icon/list
  body: json
  auth: inherit
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  Icons that `icon_name` of settings and rubrics refers to, with SVG in six styles. An `icon_name` not in the list has no SVG in the API: show an icon of your own for it.
}

meta {
  name: Update a theme
  type: http
  seq: 14
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v2/settings/theme/update
  body: json
  auth: inherit
}

body:json {
  {
    "theme_id": {{themeId}},
    "styles": "body{color:#111}"
  }
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  Changes the given fields of a theme of the site; an omitted or null field stays as it is. A shared theme or a theme of another site gives 404.
}

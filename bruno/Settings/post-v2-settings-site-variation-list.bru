meta {
  name: List site variations
  type: http
  seq: 2
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v2/settings/site-variation/list
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.timestamp: isDefined
  res.body.error: isDefined
  res.body.data: isDefined
  res.body.meta: isDefined
}

docs {
  Variations of the site: region, locale, currency. `default` — the variation without a code. Pass `code` as `site_variation` to other operations: it sets the language, country and currency of their data.
}
